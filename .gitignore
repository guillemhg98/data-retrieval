# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment variables and local secrets
.env
.env.local
.env.*.local

# Data and generated pipeline outputs
# Keep real data, generated outputs and pipeline state out of Git.
data/**
diagnosis_pipeline/
*.parquet
*.csv
*.pkl
*.pickle
*.feather
site/

# Keep lightweight selection templates and bundled sample inputs in Git.
!selections/
!selections/*.csv
!data/
!data/sample/
!data/sample/input/
!data/sample/input/*.csv

# Database files
*.db
*.sqlite
*.sqlite3

# Local spreadsheets are ignored by default. UPperRS.xlsx is reference data
# required by production runs and is intentionally versioned.
*.xlsx
*.xls
!UPperRS.xlsx
!UPperRS.example.xlsx

# Logs
*.log
logs/

# Temporary files
*.tmp
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# Project-specific
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Excel temp files
~$*.xlsx
.~lock.*

# Jupyter
.ipynb_checkpoints/
*.ipynb

# State and config (if containing sensitive data)
# state.json
# config/.env
