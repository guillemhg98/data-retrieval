# Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=synw-aquas.sql.azuresynapse.net
DB_PORT=1433
DB_DATABASE=aquas
AUTH_MODE=ActiveDirectoryIntegrated
# Optional alternatives:
# AUTH_MODE=ActiveDirectoryInteractive
# AUTH_MODE=ActiveDirectoryPassword
# DB_UID=your_user_or_service_account
# DB_PASSWORD=your_secret
# DB_CONNECTION_STRING=
# DB_CONNECT_RETRIES=1
# DB_CONNECT_RETRY_DELAY_SECONDS=10

# Base Paths
# Set to the root directory of the project
BASE_DIR=.

# Reference data file
UP_RS_FILE=UPperRS.xlsx

# Optional shared selection files
SELECTED_RS_FILE=selections/selected_rs.csv
SELECTED_UP_FILE=selections/selected_up.csv

# Optional diagnosis-only selection file
SELECTED_DIAGNOSIS_CODES_FILE=selections/selected_diagnosis_codes.csv
MAX_DIAGNOSIS_FEATURES=200000

# Logging
LOG_LEVEL=INFO
